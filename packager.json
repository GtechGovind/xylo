{
  "name": "xylo",
  "productName": "Xylo",
  "version": "0.1.1-rc.7",
  "identifier": "com.qurkos.xylo",
  "icons": ["crates/desktop/assets/xylo-icon.png"],
  "nsis": {
    "installerIcon": "crates/desktop/assets/xylo-icon.ico"
  },
  "description": "Workspace for AI conversations, coding and tools",
  "authors": [
    "Govind Yadav <gtech.govind2000@gmail.com>"
  ],
  "licenseFile": "LICENSE",
  "beforePackagingCommand": "npm ci --prefix crates/services/sandbox-helper --ignore-scripts --no-audit --no-fund",
  "binariesDir": "target/release",
  "outDir": "dist",
  "binaries": [
    {
      "path": "xylo",
      "main": true
    },
    {
      "path": "xylo-worker"
    },
    {
      "path": "xylo-helper"
    },
    {
      "path": "xylo-cli"
    },
    {
      "path": "xylo-obscura"
    }
  ],
  "resources": [
    {
      "src": "crates/services/sandbox-helper",
      "target": "sandbox-helper"
    },
    {
      "src": "LICENSE",
      "target": "licenses/LICENSE"
    },
    {
      "src": "NOTICE",
      "target": "licenses/NOTICE"
    },
    {
      "src": "target/release/obscura-licenses",
      "target": "licenses/obscura"
    }
  ]
}
